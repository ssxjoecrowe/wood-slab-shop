---
import { Image } from 'astro:assets';
interface Props {
  slug: string;
  title: string;
  species: string;
  price: number;
  dimensions: string;
  status: 'available' | 'pending' | 'sold';
  images: string[];
  featured?: boolean;
}
const { slug, title, species, price, dimensions, status, images, featured } = Astro.props;
const statusLabels = { available: 'Available', pending: 'Pending', sold: 'Sold' };
const statusClasses = { available: 'badge-available', pending: 'badge-pending', sold: 'badge-sold' };
---

<article class="card group">
  <a href={`/slabs/${slug}`} class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-wood-500 focus-visible:ring-offset-2 rounded-2xl" aria-label={`View ${title} details`}>
    <div class="relative aspect-[4/3] overflow-hidden bg-wood-100">
      {images[0] && (
        <Image
          src={images[0]}
          alt=""
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          widths={400, 800}
          formats={['avif', 'webp']}
        />
      )}
      <div class="absolute top-3 right-3">
        <span class={`badge ${statusClasses[status]}`}>{statusLabels[status]}</span>
      </div>
      {featured && (
        <div class="absolute top-3 left-3">
          <span class="badge bg-wood-700 text-white">Featured</span>
        </div>
      )}
    </div>
    <div class="p-5">
      <div class="flex items-start justify-between gap-3 mb-2">
        <h3 class="font-display font-medium text-lg text-slate-900 group-hover:text-wood-700 transition-colors">{title}</h3>
        <span class="font-display font-medium text-xl text-wood-700 whitespace-nowrap">${price}</span>
      </div>
      <p class="text-sm text-wood-600 font-medium mb-2">{species}</p>
      <p class="text-sm text-slate-500">{dimensions}</p>
    </div>
  </a>
  {status === 'available' && (
    <div class="px-5 pb-5 pt-0">
      <a href={`/contact?slab=${encodeURIComponent(title)}`} class="btn-primary w-full text-center">
        Inquire
      </a>
    </div>
  )}
</article>