---
import { getCollection } from 'astro:content';

const allSlabs = await getCollection('slabs');
const species = [...new Set(allSlabs.map((s) => s.data.species))].sort();
const statuses = ['available', 'pending', 'sold'] as const;
const priceRanges = [
  { label: 'Under $500', min: 0, max: 500 },
  { label: '$500 - $1,000', min: 500, max: 1000 },
  { label: '$1,000 - $2,000', min: 1000, max: 2000 },
  { label: 'Over $2,000', min: 2000, max: Infinity },
];
---

<div class="sticky top-20 z-40 bg-white/95 backdrop-blur-sm border-b border-wood-200" id="filters">
  <div class="container-custom py-4">
    <button
      type="button"
      class="md:hidden btn-secondary w-full mb-4 gap-2"
      aria-expanded="false"
      aria-controls="filter-panel"
      onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'); document.getElementById('filter-panel').classList.toggle('hidden')"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 18a1 1 0 001-1v-2.586a1 1 0 01.293-.707l6.414-6.414a1 1 0 00.293-.707V5l4-4v6.586a1 1 0 00.293.707l6.414 6.414a1 1 0 01-.293.707V17a1 1 0 01-1 1h-2" />
      </svg>
      Filters
    </button>

    <div id="filter-panel" class="hidden md:block">
      <form id="filter-form" class="flex flex-wrap items-end gap-4" role="search" aria-label="Slab filters">
        <div class="flex-1 min-w-[180px]">
          <label for="species" class="label">Species</label>
          <select id="species" name="species" class="input" aria-label="Filter by wood species">
            <option value="">All Species</option>
            {species.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>

        <div class="flex-1 min-w-[180px]">
          <label for="status" class="label">Status</label>
          <select id="status" name="status" class="input" aria-label="Filter by availability">
            <option value="">All Statuses</option>
            {statuses.map((s) => (
              <option value={s}>{s.charAt(0).toUpperCase() + s.slice(1)}</option>
            ))}
          </select>
        </div>

        <div class="flex-1 min-w-[180px]">
          <label for="price" class="label">Price Range</label>
          <select id="price" name="price" class="input" aria-label="Filter by price range">
            <option value="">Any Price</option>
            {priceRanges.map((r) => (
              <option value={`${r.min}-${r.max}`}>{r.label}</option>
            ))}
          </select>
        </div>

        <div class="flex-1 min-w-[180px]">
          <label for="sort" class="label">Sort By</label>
          <select id="sort" name="sort" class="input" aria-label="Sort results">
            <option value="newest">Newest First</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
            <option value="species">Species A-Z</option>
          </select>
        </div>

        <button type="submit" class="btn-primary h-fit">
          Apply
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
        </button>

        <a href="/slabs" class="btn-ghost h-fit" aria-label="Clear all filters">
          Clear
        </a>
      </form>
    </div>
  </div>
</div>

<script>
  document.getElementById('filter-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const params = new URLSearchParams(new FormData(form));
    const url = new URL(window.location.href);
    url.search = params.toString();
    window.history.pushState({}, '', url);
    window.location.reload();
  });

  const urlParams = new URLSearchParams(window.location.search);
  ['species', 'status', 'price', 'sort'].forEach((key) => {
    const value = urlParams.get(key);
    if (value) {
      const el = document.getElementById(key) as HTMLSelectElement;
      if (el) el.value = value;
    }
  });
</script>

<style>
  @media (max-width: 767px) {
    #filter-panel:not(.hidden) {
      display: block;
      animation: slideDown 0.3s ease-out;
    }
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>