---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import FeaturedSlabs from '@/components/FeaturedSlabs.astro';
---

<Layout title="Wood Slab Shop - Premium Kiln-Dried Wood Slabs" description="Curated selection of premium wood slabs for furniture makers. Black Walnut, White Oak, Maple, Cherry, and exotic species. Sustainably sourced, kiln-dried, ready to finish.">
  <Header />
  <main id="main-content">
    <Hero />
    <FeaturedSlabs />

    <section class="section bg-white" aria-labelledby="why-heading">
      <div class="container-custom">
        <header class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
          <h2 id="why-heading" class="font-display font-medium text-display-lg text-slate-900 mb-4">
            Why Choose Our Slabs
          </h2>
          <p class="text-lg text-slate-600 leading-relaxed">
            Every slab in our collection is hand-selected for quality, character, and workability.
          </p>
        </header>

        <div class="grid gap-8 md:grid-cols-3">
          <article class="text-center p-6">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-wood-100 flex items-center justify-center text-wood-600">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="font-display font-medium text-xl text-slate-900 mb-2">Hand-Selected</h3>
            <p class="text-slate-600">Every slab personally inspected for grain quality, figure, and structural integrity.</p>
          </article>

          <article class="text-center p-6">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-wood-100 flex items-center justify-center text-wood-600">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
            </div>
            <h3 class="font-display font-medium text-xl text-slate-900 mb-2">Kiln-Dried</h3>
            <p class="text-slate-600">Properly dried to 6-8% moisture content for stability and immediate use.</p>
          </article>

          <article class="text-center p-6">
            <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-wood-100 flex items-center justify-center text-wood-600">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-display font-medium text-xl text-slate-900 mb-2">Sustainably Sourced</h3>
            <p class="text-slate-600">Responsibly harvested from managed forests and urban salvage operations.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section bg-wood-100" aria-labelledby="cta-heading">
      <div class="container-custom text-center">
        <h2 id="cta-heading" class="font-display font-medium text-display-lg text-slate-900 mb-4">
          Ready to Start Your Project?
        </h2>
        <p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
          Browse our complete collection or contact us with questions about a specific slab.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/slabs" class="btn-primary w-full sm:w-auto px-10 py-4 text-lg">
            View All Slabs
          </a>
          <a href="/contact" class="btn-outline w-full sm:w-auto px-10 py-4 text-lg">
            Contact Us
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>